---
/* src/components/app/AppHeader.astro */
const pathname = Astro.url.pathname;
---
<header class="absolute top-0 left-0 right-0 z-50 px-6 lg:px-12 pt-6 lg:pt-8 mx-auto w-full max-w-[1400px] pointer-events-none">
  
  <div id="main-header-container" class="flex items-center justify-between pointer-events-auto relative z-[70] transition-opacity duration-300">
    
    <div id="header-logo" class="flex-1 flex items-center z-[80]">
      <a href="/app/vestiaire" class="inline-block hover:opacity-80 transition-opacity mt-1">
        <img src="/logo.svg" alt="Logo Be Drippy" class="h-9 w-auto max-w-none" />
      </a>
    </div>

    <!-- Navigation Bureau -->
    <div id="header-content" class="hidden lg:flex flex-1 items-center justify-center transition-opacity duration-300">
        <nav class="flex justify-center items-center gap-8">
            <a href="/app/vestiaire" class={`font-display uppercase text-corp-md tracking-wider transition-colors whitespace-nowrap ${pathname === '/app/vestiaire' ? 'text-jaune' : 'text-white hover:text-jaune'}`}>Vestiaire</a>
            
            <!-- Lien masqué par défaut, affiché par le JS -->
            <a href="/app/communaute" class={`premium-link hidden font-display uppercase text-corp-md tracking-wider transition-colors whitespace-nowrap ${pathname === '/app/communaute' ? 'text-jaune' : 'text-white hover:text-jaune'}`}>Communauté</a>
            
            <a href="/app/profile" class={`font-display uppercase text-corp-md tracking-wider transition-colors whitespace-nowrap ${pathname === '/app/profile' ? 'text-jaune' : 'text-white hover:text-jaune'}`}>Profil</a>
            <a href="/app/meteo" class={`font-display uppercase text-corp-md tracking-wider transition-colors whitespace-nowrap ${pathname === '/app/meteo' ? 'text-jaune' : 'text-white hover:text-jaune'}`}>Météo</a>
            <a href="/app/parametre" class={`font-display uppercase text-corp-md tracking-wider transition-colors whitespace-nowrap ${pathname === '/app/parametre' ? 'text-jaune' : 'text-white hover:text-jaune'}`}>Réglages</a>
        </nav>
    </div>

    <!-- Menu Burger Mobile -->
    <button id="menu-toggle" class="lg:hidden flex flex-col justify-center items-end gap-1 h-10 w-15 pointer-events-auto z-[80]">
      <span id="line1" class="block w-12 h-[4px] bg-white rounded-full transition-all duration-300"></span>
      <span id="line2" class="block w-12 h-[4px] bg-white rounded-full transition-all duration-300"></span>
      <span id="line3" class="block w-12 h-[4px] bg-white rounded-full transition-all duration-300"></span>
    </button>
  </div>

  <!-- Overlay Mobile Fullscreen -->
  <div id="menu-overlay" class="fixed inset-0 bg-bleu-marine -translate-y-full transition-transform duration-500 ease-in-out z-[65] flex flex-col items-center justify-center gap-8 pointer-events-none">
    <div class="flex flex-col items-center gap-6 pointer-events-auto">
      
      <a href="/app/vestiaire" class={`menu-link font-display text-3xl uppercase ${pathname === '/app/vestiaire' ? 'text-jaune' : 'text-white'}`}>Vestiaire</a>
      
      <!-- Lien masqué par défaut -->
      <a href="/app/communaute" class={`premium-link hidden menu-link font-display text-3xl uppercase ${pathname === '/app/communaute' ? 'text-jaune' : 'text-white'}`}>Communauté</a>
      
      <a href="/app/profile" class={`menu-link font-display text-3xl uppercase ${pathname === '/app/profile' ? 'text-jaune' : 'text-white'}`}>Profil</a>
      <a href="/app/meteo" class={`menu-link font-display text-3xl uppercase ${pathname === '/app/meteo' ? 'text-jaune' : 'text-white'}`}>Météo</a>
      <a href="/app/parametre" class={`menu-link font-display text-3xl uppercase ${pathname === '/app/parametre' ? 'text-jaune' : 'text-white'}`}>Réglages</a>
      
      <div class="w-full h-[1px] bg-white/20 my-4 max-w-[200px]"></div>
    </div>
  </div>
</header>

<script>
  import { pb } from '../../../backend/pb.mjs';

  // 1. GESTION DE L'AFFICHAGE PREMIUM
  const user = pb.authStore.model;
  if (user && user.is_premium === true) {
    document.querySelectorAll('.premium-link').forEach(link => {
      link.classList.remove('hidden');
    });
  }

  // 2. GESTION DU MENU BURGER
  const btn = document.getElementById('menu-toggle');
  const overlay = document.getElementById('menu-overlay');
  const headerContent = document.getElementById('header-content');
  const links = document.querySelectorAll('.menu-link');
  const l1 = document.getElementById('line1');
  const l2 = document.getElementById('line2');
  const l3 = document.getElementById('line3');

  function toggleMenu() {
    overlay?.classList.toggle('-translate-y-full');
    overlay?.classList.toggle('pointer-events-none');
    headerContent?.classList.toggle('opacity-0'); 
    
    l1?.classList.toggle('rotate-45');
    l1?.classList.toggle('translate-y-[8px]');
    l2?.classList.toggle('opacity-0');
    l3?.classList.toggle('-rotate-45');
    l3?.classList.toggle('-translate-y-[8px]');
    document.body.classList.toggle('overflow-hidden');
  }

  btn?.addEventListener('click', toggleMenu);
  links.forEach(link => link.addEventListener('click', toggleMenu));
</script>

<style>
  #line1, #line2, #line3 { transform-origin: center; transition: all 0.3s ease-in-out; }
</style>