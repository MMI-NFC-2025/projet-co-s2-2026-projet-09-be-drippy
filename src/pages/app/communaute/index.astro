---
/* src/pages/app/communaute/index.astro */
import AppLayout from '../../../layouts/AppLayout.astro';
---

<AppLayout title="Communauté">
  
  <div class="fixed inset-0 bg-bleu-claire z-0"></div>

  <div class="min-h-screen flex flex-col relative overflow-x-hidden pt-4">

    <div class="w-full flex-grow flex flex-col relative mt-8 lg:mt-12">
      
      <div class="absolute inset-0 flex flex-col pointer-events-none z-0">
        <div class="w-full aspect-square lg:aspect-[4/1] bg-bleu-marine rounded-full lg:rounded-t-[8rem] lg:rounded-b-none shadow-[0_-10px_40px_rgba(0,0,0,0.1)]"></div>
        <div class="w-full flex-grow bg-bleu-marine -mt-[50%] lg:-mt-[12%]"></div>
      </div>
      

      <div class="relative z-10 w-full flex flex-col items-center px-4 lg:px-12 max-w-5xl mx-auto pt-[calc(50vw-7rem)] lg:pt-12 pb-24 text-white">
        
        <h1 class="text-3xl lg:text-5xl font-black font-display tracking-wide uppercase text-center mb-10 drop-shadow-md lg:drop-shadow-none">Communauté</h1>

        <div class="flex flex-col md:flex-row w-full justify-between items-center gap-6 mb-12">
          
          <div class="flex bg-white/20 lg:bg-white/10 p-1.5 rounded-full border border-white/30 backdrop-blur-md shadow-inner">
            <button id="tab-feed" class="px-6 py-2.5 rounded-full bg-jaune text-bleu-marine font-bold text-sm lg:text-base transition-all shadow-md active:scale-95">Le Feed</button>
            <button id="tab-favs" class="px-6 py-2.5 rounded-full text-white hover:bg-white/20 font-bold text-sm lg:text-base transition-all active:scale-95">Mes Favoris</button>
          </div>

          <button id="btn-open-share" class="bg-bleu-claire text-bleu-marine px-6 py-3 rounded-full font-black uppercase tracking-widest text-sm hover:bg-white transition-all shadow-xl border-4 border-white/50 flex items-center gap-2 hover:scale-105 active:scale-95 w-full md:w-auto justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
            </svg>
            Partager ma tenue
          </button>
        </div>

        <div id="community-loading" class="w-full py-16 flex flex-col items-center justify-center bg-bleu-claire rounded-[3rem] shadow-2xl border-4 border-white/50">
          <div class="w-12 h-12 border-4 border-bleu-marine/20 border-t-jaune rounded-full animate-spin mb-6"></div>
          <p class="text-base font-bold text-bleu-marine">Chargement des tenues...</p>
        </div>

        <div id="community-feed" class="w-full flex flex-col gap-8 hidden">
        </div>

      </div>
    </div>
  </div>


  <div id="share-modal" class="fixed inset-0 z-[100] hidden items-center justify-center bg-bleu-marine/80 backdrop-blur-sm p-4 transition-opacity">
    <div class="bg-bleu-claire w-full max-w-lg rounded-[3rem] p-8 shadow-2xl border-4 border-white/50 flex flex-col items-center relative" onclick="event.stopPropagation()">
      
      <button id="close-share-modal" class="absolute top-6 right-6 w-10 h-10 bg-white hover:bg-gray-100 text-bleu-marine rounded-full flex items-center justify-center font-bold transition-colors shadow-md">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
      
      <h3 class="text-2xl font-black uppercase tracking-widest text-bleu-marine mb-2 font-display text-center">Publier ma tenue</h3>
      <p class="text-sm font-bold text-bleu-marine/60 mb-8 text-center px-4">Ajoutez une légende à votre toute dernière tenue validée.</p>
      
      <form id="share-form" class="w-full flex flex-col gap-5">
        <textarea id="share-caption" placeholder="Ex: Ma tenue chill pour la plage ✨" rows="3" required class="w-full bg-white rounded-[2rem] p-5 text-bleu-marine font-bold focus:outline-none focus:ring-4 focus:ring-jaune shadow-inner resize-none text-base border-2 border-white/50"></textarea>
        
        <button type="submit" id="btn-submit-share" class="w-full bg-jaune hover:bg-yellow-400 text-bleu-marine font-black uppercase tracking-widest py-4 rounded-full transition-all shadow-lg active:scale-95 text-lg mt-2">
          Publier
        </button>
      </form>

    </div>
  </div>

</AppLayout>

<script>
  import { pb } from '../../../../backend/pb.mjs';
  import { initCommunity } from '../../../../backend/community.js';

  if (!pb.authStore.isValid) {
    window.location.href = '/app/login';
  } else {
    initCommunity();
  }

  const user = pb.authStore.model;
  if (!user || user.is_premium !== true) {
    window.location.href = '/app/parametre';
  }
</script>

