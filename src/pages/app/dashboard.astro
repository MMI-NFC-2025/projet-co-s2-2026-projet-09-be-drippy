---
/* src/pages/app/dashboard.astro */
import AppLayout from '../../layouts/AppLayout.astro';
---

<AppLayout title="Mon Vestiaire">
  <!-- On a supprimé le pb-24 ici, car AppLayout gère déjà le padding nécessaire -->
  <div class="min-h-screen bg-gray-50"> 
    
    <!-- HEADER : Profil -->
    <header class="bg-bleu-marine text-white p-8 rounded-b-[3rem] shadow-lg">
      <div class="flex items-center gap-6">
        <div class="relative">
          <img src="/avatar-placeholder.png" alt="Profil" class="w-20 h-20 rounded-full border-4 border-jaune bg-white" />
          <button class="absolute bottom-0 right-0 bg-white p-2 rounded-full text-bleu-marine shadow">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" /></svg>
          </button>
        </div>
        <div>
          <h2 class="text-2xl font-black">Thomas P.</h2>
          <p class="text-jaune font-medium opacity-90">@thom.drippy</p>
        </div>
      </div>
    </header>

    <!-- CONTENT : Garde-robe -->
    <main class="p-6">
      <div class="flex justify-between items-center mb-6">
        <h3 class="text-xl font-bold text-bleu-marine">Ma Garde-robe</h3>
        <button class="bg-bleu-marine text-white px-4 py-2 rounded-full text-sm font-bold shadow-md hover:scale-105 transition-transform">
          + Ajouter
        </button>
      </div>

      <!-- État vide -->
      <div class="border-2 border-dashed border-gray-300 rounded-[2rem] p-12 flex flex-col items-center text-center gap-4">
        <div class="w-16 h-16 bg-gray-200 rounded-full flex items-center justify-center">
          <span class="text-2xl">👕</span>
        </div>
        <p class="text-gray-500 font-medium">Votre garde-robe est vide.<br/>Commencez par ajouter une pièce !</p>
      </div>
    </main>

    <!-- La navigation a été retirée d'ici car elle est maintenant dans AppLayout -->

  </div>
</AppLayout>