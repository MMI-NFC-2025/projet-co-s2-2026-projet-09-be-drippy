---
/* src/pages/app/weather/index.astro */
import AppLayout from '../../../layouts/AppLayout.astro';
import AppHeader from '../../../components/app/AppHeader.astro';
---

<AppLayout title="Météo">
  
  <!-- FOND GLOBAL BLEU CLAIR -->
  <div class="fixed inset-0 bg-bleu-claire z-0"></div>

  <!-- CONTENEUR DE PAGE -->
  <div class="min-h-screen flex flex-col relative overflow-x-hidden pt-4">

    <!-- CONTENEUR PRINCIPAL -->
    <div class="w-full flex-grow flex flex-col relative mt-8 lg:mt-12">
      
      <!-- COUCHE D'ARRIÈRE-PLAN BLEU MARINE -->
      <div class="absolute inset-0 flex flex-col pointer-events-none z-0">
        <div class="w-full aspect-square lg:aspect-[4/1] bg-bleu-marine rounded-full lg:rounded-t-[8rem] lg:rounded-b-none shadow-[0_-10px_40px_rgba(0,0,0,0.1)]"></div>
        <div class="w-full flex-grow bg-bleu-marine -mt-[50%] lg:-mt-[12%]"></div>
      </div>

      <!-- COUCHE DE CONTENU -->
      <div class="relative z-10 w-full flex-grow flex flex-col items-center px-6 lg:px-12 max-w-[1400px] mx-auto pt-[15%] lg:pt-10 pb-24 text-white">
        
        <!-- Titre -->
        <h1 class="text-3xl lg:text-5xl font-black font-display tracking-wide uppercase text-center">Météo</h1>
        <p class="text-bleu-claire text-sm lg:text-base font-medium mt-1 text-center mb-8">Le temps prévu pour vos tenues.</p>

        <!-- ÉTAT DE CHARGEMENT -->
        <div id="loading-state" class="flex flex-col items-center justify-center w-full max-w-md bg-white/5 backdrop-blur-sm rounded-[3rem] p-12 shadow-xl border border-white/10">
          <div class="w-16 h-16 border-4 border-white/20 border-t-jaune rounded-full animate-spin mb-6"></div>
          <p class="font-bold text-lg text-white animate-pulse">Analyse du ciel...</p>
        </div>

        <!-- ÉTAT D'ERREUR (Saisie de la ville incluse) -->
        <div id="error-state" class="hidden flex-col items-center justify-center w-full max-w-md bg-white/5 backdrop-blur-sm rounded-[3rem] p-8 lg:p-12 shadow-xl border border-white/10 text-center">
          <span class="text-6xl mb-6">🌍</span>
          <h2 class="text-2xl font-black mb-2 text-white">Oups !</h2>
          <p id="error-text" class="font-medium text-bleu-claire mb-6">Ville introuvable ou non renseignée.</p>
          
          <form id="error-city-form" class="w-full flex flex-col gap-3">
            <input type="text" id="error-city-input" placeholder="Entrez votre ville..." required class="w-full bg-white/10 border border-white/20 rounded-full px-5 py-3 text-white font-bold focus:outline-none focus:ring-2 focus:ring-jaune placeholder-white/50 text-center">
            <button type="submit" class="w-full bg-jaune text-bleu-marine font-extrabold px-6 py-3 rounded-full shadow-lg hover:scale-105 transition-transform active:scale-95">
              Sauvegarder
            </button>
          </form>
        </div>

        <!-- CONTENU MÉTÉO -->
        <div id="weather-content" class="hidden w-full max-w-md flex-col gap-8">
          
          <!-- CARTE PRINCIPALE -->
          <div class="bg-white/10 backdrop-blur-md rounded-[3rem] p-8 flex flex-col items-center shadow-2xl border border-white/20 relative overflow-hidden">
            <!-- Déco d'arrière plan -->
            <div class="absolute -top-10 -right-10 w-40 h-40 bg-white/5 rounded-full blur-2xl"></div>
            
            <!-- Affichage de la ville avec bouton modifier -->
            <div id="city-display-container" class="flex items-center gap-3 z-10 mb-2">
              <h2 id="city-name" class="text-2xl font-black uppercase tracking-widest text-bleu-claire">--</h2>
              <button id="edit-city-btn" class="bg-white/10 p-2 rounded-full text-bleu-claire hover:text-jaune hover:bg-white/20 transition-all active:scale-95" title="Modifier la ville">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" />
                </svg>
              </button>
            </div>

            <!-- Formulaire pour modifier la ville (masqué par défaut) -->
            <form id="edit-city-form" class="hidden items-center gap-2 z-10 mb-2 w-full max-w-[250px]">
              <input type="text" id="edit-city-input" required class="w-full bg-white/10 border border-white/30 rounded-full px-4 py-1.5 text-white font-bold focus:outline-none focus:ring-2 focus:ring-jaune placeholder-white/50 text-center uppercase tracking-widest text-sm" placeholder="Nouvelle ville...">
              <button type="submit" class="bg-jaune text-bleu-marine p-2 rounded-full hover:scale-105 transition-transform active:scale-95">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
              </button>
            </form>

            <div id="current-icon" class="text-[8rem] leading-none my-2 z-10 drop-shadow-xl cursor-default">☁️</div>
            
            <div class="flex items-start z-10 mb-8 mt-2">
              <span id="current-temp" class="text-7xl font-black font-display tracking-tighter">--</span>
              <span class="text-3xl font-bold mt-2 text-jaune">°C</span>
            </div>

            <!-- Stats (Ressenti, Vent, Humidité) -->
            <div class="flex gap-4 w-full justify-between bg-black/20 rounded-3xl p-5 z-10 shadow-inner border border-white/5">
              <div class="flex flex-col items-center flex-1">
                <span class="text-[10px] text-bleu-claire font-black uppercase tracking-wider mb-1">Ressenti</span>
                <span class="font-black text-xl"><span id="feels-like">--</span>°</span>
              </div>
              <div class="w-[1px] bg-white/10"></div>
              <div class="flex flex-col items-center flex-1">
                <span class="text-[10px] text-bleu-claire font-black uppercase tracking-wider mb-1">Vent</span>
                <span class="font-black text-xl"><span id="wind">--</span><span class="text-xs font-medium text-white/70 ml-1">km/h</span></span>
              </div>
              <div class="w-[1px] bg-white/10"></div>
              <div class="flex flex-col items-center flex-1">
                <span class="text-[10px] text-bleu-claire font-black uppercase tracking-wider mb-1">Humidité</span>
                <span class="font-black text-xl"><span id="humidity">--</span>%</span>
              </div>
            </div>
          </div>

        </div>

      </div>
    </div>
  </div>
</AppLayout>

<script>
  import { pb } from '../../../../backend/pb.mjs';
  import { getWeather } from '../../../../backend/weather.js'; 

  if (!pb.authStore.isValid) {
    window.location.href = '/app/login';
  }

  // Éléments d'états
  const loadingState = document.getElementById('loading-state');
  const errorState = document.getElementById('error-state');
  const errorText = document.getElementById('error-text');
  const weatherContent = document.getElementById('weather-content');

  // Éléments de données météo
  const elCity = document.getElementById('city-name');
  const elIcon = document.getElementById('current-icon');
  const elTemp = document.getElementById('current-temp');
  const elFeelsLike = document.getElementById('feels-like');
  const elWind = document.getElementById('wind');
  const elHumidity = document.getElementById('humidity');

  // Éléments d'édition de la ville (dans la carte)
  const cityDisplayContainer = document.getElementById('city-display-container');
  const editCityBtn = document.getElementById('edit-city-btn');
  const editCityForm = document.getElementById('edit-city-form');
  const editCityInput = document.getElementById('edit-city-input') as HTMLInputElement;

  // Éléments d'édition de la ville (dans l'erreur)
  const errorCityForm = document.getElementById('error-city-form');
  const errorCityInput = document.getElementById('error-city-input') as HTMLInputElement;

  // Fonction principale de chargement
  async function initWeather() {
    // Reset de l'affichage
    errorState?.classList.add('hidden');
    errorState?.classList.remove('flex');
    weatherContent?.classList.add('hidden');
    weatherContent?.classList.remove('flex');
    loadingState?.classList.remove('hidden');
    loadingState?.classList.add('flex');

    try {
      const userId = pb.authStore.model?.id;
      const data = await getWeather(userId);

      if (elCity) elCity.textContent = data.city;
      if (elIcon) elIcon.textContent = data.icon;
      if (elTemp) elTemp.textContent = Math.round(data.temperature).toString();
      if (elFeelsLike) elFeelsLike.textContent = Math.round(data.feelsLike).toString();
      if (elWind) elWind.textContent = Math.round(data.wind).toString();
      if (elHumidity) elHumidity.textContent = Math.round(data.humidity).toString();

      loadingState?.classList.add('hidden');
      loadingState?.classList.remove('flex');
      weatherContent?.classList.remove('hidden');
      weatherContent?.classList.add('flex');

    } catch (err: any) {
      console.error(err);
      loadingState?.classList.add('hidden');
      loadingState?.classList.remove('flex');
      errorState?.classList.remove('hidden');
      errorState?.classList.add('flex');
      if (errorText) errorText.textContent = err.message || "Une erreur est survenue lors de la récupération de la météo.";
    }
  }

  // Fonction pour mettre à jour la ville dans PocketBase
  async function updateCity(newCity: string) {
    if (!newCity || newCity.trim() === '') return;
    
    try {
      const userId = pb.authStore.model?.id;
      // Mise à jour en base de données
      await pb.collection('users').update(userId, { city: newCity.trim() });
      
      // Rafraîchissement des cookies et du store local
      await pb.collection('users').authRefresh();
      document.cookie = pb.authStore.exportToCookie({ httpOnly: false, path: '/' });

      // On recharge la météo
      initWeather();
    } catch (err) {
      console.error("Erreur de mise à jour de la ville :", err);
      alert("Impossible de mettre à jour la ville.");
    }
  }

  // --- Écouteurs d'événements pour l'édition dans la carte ---
  editCityBtn?.addEventListener('click', () => {
    cityDisplayContainer?.classList.add('hidden');
    cityDisplayContainer?.classList.remove('flex');
    editCityForm?.classList.remove('hidden');
    editCityForm?.classList.add('flex');
    if (editCityInput) {
      editCityInput.value = elCity?.textContent !== '--' ? (elCity?.textContent || '') : '';
      editCityInput.focus();
    }
  });

  editCityForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const newCity = editCityInput?.value;
    
    // On remet l'affichage normal
    editCityForm.classList.add('hidden');
    editCityForm.classList.remove('flex');
    cityDisplayContainer?.classList.remove('hidden');
    cityDisplayContainer?.classList.add('flex');
    
    if (newCity) updateCity(newCity);
  });

  // --- Écouteurs d'événements pour l'édition depuis l'état d'erreur ---
  errorCityForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const newCity = errorCityInput?.value;
    if (newCity) updateCity(newCity);
  });

  // Démarrage initial
  initWeather();
</script>