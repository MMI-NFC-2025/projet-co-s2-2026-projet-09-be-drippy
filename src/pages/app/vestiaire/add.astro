---
/* src/pages/app/vestiaire/add.astro */
import AppLayout from '../../../layouts/AppLayout.astro';
import AppHeader from '../../../components/app/AppHeader.astro';
export const prerender = false;
---

<AppLayout title="Ajouter une pièce">
  
  <!-- FOND GLOBAL BLEU CLAIR (Fixé en arrière-plan) -->
  <div class="fixed inset-0 bg-bleu-claire -z-10"></div>

  <!-- CONTENEUR DE PAGE -->
  <div class="min-h-screen flex flex-col relative overflow-x-hidden pt-2 lg:pt-8">

    <!-- CONTENEUR PRINCIPAL -->
    <div class="w-full flex-grow flex flex-col relative mt-6 lg:mt-12">
      
      <!-- COUCHE D'ARRIÈRE-PLAN BLEU MARINE (Cercle + Rectangle) -->
      <div class="absolute inset-0 flex flex-col pointer-events-none z-0">
        <div class="w-full aspect-square lg:aspect-[4/1] bg-bleu-marine rounded-full lg:rounded-t-[8rem] lg:rounded-b-none shadow-[0_-10px_40px_rgba(0,0,0,0.1)]"></div>
        <div class="w-full flex-grow bg-bleu-marine -mt-[50%] lg:-mt-[12%]"></div>
      </div>

      <!-- COUCHE DE CONTENU -->
      <div class="relative z-10 w-full flex-grow flex flex-col items-center px-6 lg:px-12 max-w-[800px] mx-auto pt-[12%] lg:pt-10 pb-24">
        
        <!-- Bouton Annuler (Adapté pour le fond sombre) -->
        <a href="/app/vestiaire" class="bg-jaune text-bleu-marine border border-white/20 px-6 py-2.5 rounded-full font-bold mb-6 transition-colors hover:bg-jaune flex items-center gap-2 shadow-sm hover:scale-105 active:scale-95">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
          </svg>
          Annuler
        </a>

        <!-- Titre & Sous-titre -->
        <h1 class="text-3xl lg:text-5xl font-black text-white font-display tracking-wide uppercase text-center mb-2">Scanner</h1>
        <p class="text-bleu-claire font-medium mb-8 text-center px-4">Ajoutez la photo, notre IA se charge d'analyser et de tagger la pièce pour vous</p>

        <!-- FORMULAIRE (Intact, posé sur le fond bleu) -->
        <form id="add-cloth-form" class="w-full bg-white rounded-[3rem] p-6 lg:p-8 shadow-2xl border border-gray-100 flex flex-col gap-6 relative overflow-hidden">
          
          <div id="ai-loading-overlay" class="absolute inset-0 bg-white/90 backdrop-blur-sm z-50 hidden flex-col items-center justify-center">
            <div class="w-16 h-16 border-4 border-gray-100 border-t-jaune rounded-full animate-spin mb-4"></div>
            <h3 class="text-xl font-black text-bleu-marine animate-pulse">L'IA analyse votre pièce...</h3>
            <p class="text-sm text-gray-500 font-medium mt-2">Détection de la catégorie et de la météo</p>
          </div>

          <div class="w-full">
            <label class="block text-bleu-marine font-black uppercase tracking-wider text-sm mb-2">Photo de l'article *</label>
            <div class="relative w-full aspect-square md:aspect-video rounded-[2rem] border-2 border-dashed border-gray-300 bg-gray-50 hover:bg-gray-100 transition-colors flex flex-col items-center justify-center overflow-hidden cursor-pointer" id="image-upload-container">
              <div id="upload-placeholder" class="flex flex-col items-center pointer-events-none">
                <span class="text-4xl mb-2">📸</span>
                <span class="text-gray-500 font-bold text-sm">Cliquez pour ajouter une photo</span>
              </div>
              <img id="image-preview" src="" alt="Aperçu" class="absolute inset-0 w-full h-full object-cover hidden" />
              <input type="file" id="image" name="image" accept="image/*" required class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10" />
            </div>
          </div>

          <div>
            <label for="name" class="block text-bleu-marine font-black uppercase tracking-wider text-sm mb-2">Nom de la pièce *</label>
            <input type="text" id="name" name="name" required placeholder="Ex: Manteau d'hiver" class="w-full bg-gray-50 border border-gray-200 rounded-2xl px-5 py-4 font-medium focus:outline-none focus:border-bleu-marine transition-all" />
          </div>

          <div class="flex items-center gap-3 mt-2">
            <input type="checkbox" id="is_favorite" name="is_favorite" value="true" class="w-6 h-6 rounded border-gray-300 text-bleu-marine focus:ring-bleu-marine" />
            <label for="is_favorite" class="text-bleu-marine font-bold text-sm">Ajouter aux favoris</label>
          </div>

          <button type="submit" id="submit-btn" class="w-full bg-bleu-marine text-white font-extrabold text-xl py-5 rounded-full shadow-lg hover:scale-[1.02] transition-transform active:scale-95 mt-4 flex justify-center items-center gap-2 group">
            <span>Ajouter</span>
          </button>

          <div id="error-message" class="hidden text-red-500 font-bold text-center mt-2"></div>
        </form>

      </div>
    </div>
  </div>
</AppLayout>

<script>
  import { pb } from '../../../../backend/pb.mjs'; 
  import { addCloth } from '../../../../backend/clothes.js';

  if (!pb.authStore.isValid) {
    window.location.href = '/app/login';
  }

  const form = document.getElementById('add-cloth-form');
  const imageInput = document.getElementById('image');
  const imagePreview = document.getElementById('image-preview');
  const uploadPlaceholder = document.getElementById('upload-placeholder');
  const submitBtn = document.getElementById('submit-btn');
  const aiOverlay = document.getElementById('ai-loading-overlay');
  const errorMessage = document.getElementById('error-message');
  // Pour animer le texte de l'overlay :
  const overlayText = aiOverlay?.querySelector('h3'); 

  // Affichage de l'image initiale
  imageInput?.addEventListener('change', function(e) {
    // @ts-ignore
    const file = e.target.files?.[0];
    if (file && imagePreview && uploadPlaceholder) {
      const reader = new FileReader();
      reader.onload = function(event) {
        // @ts-ignore
        imagePreview.src = event.target.result;
        imagePreview.classList.remove('hidden');
        uploadPlaceholder.classList.add('hidden');
      }
      reader.readAsDataURL(file);
    }
  });

  // Soumission
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    if (!submitBtn || !aiOverlay || !errorMessage || !overlayText) return;

    // @ts-ignore
    submitBtn.disabled = true;
    aiOverlay.classList.remove('hidden');
    aiOverlay.classList.add('flex');
    errorMessage.classList.add('hidden');

    try {
      // @ts-ignore
      const formData = new FormData(form);
      const userId = pb.authStore.model?.id || '';
      formData.append('user', userId);

      // --- ÉTAPE 1 : DÉTOURAGE MAGIQUE ---
      overlayText.textContent = "✂️ Détourage en cours...";
      const removeBgResponse = await fetch('/api/remove-bg', {
        method: 'POST',
        body: formData // On envoie l'image d'origine
      });

      if (!removeBgResponse.ok) throw new Error("Le détourage a échoué.");

      // On transforme la réponse en un vrai fichier PNG
      const croppedBlob = await removeBgResponse.blob();
      const croppedFile = new File([croppedBlob], "vetement-detoure.png", { type: 'image/png' });

      // On remplace l'ancienne image par la nouvelle image détourée dans le formulaire !
      formData.set('image', croppedFile);
      
      // Bonus visuel : on met à jour l'image en arrière-plan pendant que Gemini réfléchit
      // @ts-ignore
      imagePreview.src = URL.createObjectURL(croppedFile);

      // --- ÉTAPE 2 : ANALYSE GEMINI ---
      overlayText.textContent = "✨ Analyse IA de la pièce...";
      const aiResponse = await fetch('/api/analyze', {
        method: 'POST',
        body: formData // Cette fois on envoie l'image détourée !
      });

      if (!aiResponse.ok) throw new Error("Erreur lors de l'analyse IA");

      const tags = await aiResponse.json();
      formData.append('category', tags.category);
      formData.append('weather_tag', tags.weather_tag);

      // --- ÉTAPE 3 : SAUVEGARDE POCKETBASE ---
      overlayText.textContent = "💾 Sauvegarde dans le vestiaire...";
      await addCloth(formData);

      window.location.href = '/app/vestiaire';

    } catch (error) {
      console.error("Erreur générale :", error);
      errorMessage.textContent = "Une erreur est survenue (vérifiez votre connexion ou l'image).";
      errorMessage.classList.remove('hidden');
      // @ts-ignore
      submitBtn.disabled = false;
      aiOverlay.classList.add('hidden');
      aiOverlay.classList.remove('flex');
    }
  });
</script>