---
/* src/pages/app/vestiaire/index.astro */
import AppLayout from '../../../layouts/AppLayout.astro';
---

<AppLayout title="Mon Vestiaire">
  
  <!-- FOND GLOBAL BLEU CLAIR (Fixé pour couvrir absolument tout l'écran, même derrière le header) -->
  <div class="fixed inset-0 bg-bleu-claire -z-10"></div>

  <!-- CONTENEUR DE PAGE -->
  <div class="min-h-screen flex flex-col relative overflow-x-hidden pt-2 lg:pt-8">

    <!-- CONTENEUR PRINCIPAL DU VESTIAIRE -->
    <div class="w-full flex-grow flex flex-col relative mt-6 lg:mt-12">
      
      <!-- COUCHE D'ARRIÈRE-PLAN BLEU MARINE (Cercle parfait + Rectangle) -->
      <div class="absolute inset-0 flex flex-col pointer-events-none z-0">
        <!-- Le Cercle (Diamètre = largeur de la page) -->
        <div class="w-full aspect-square lg:aspect-[4/1] bg-bleu-marine rounded-full lg:rounded-t-[8rem] lg:rounded-b-none shadow-[0_-10px_40px_rgba(0,0,0,0.1)]"></div>
        <!-- Le Rectangle (S'étire à l'infini vers le bas, et démarre exactement au milieu du cercle via -mt-50%) -->
        <div class="w-full flex-grow bg-bleu-marine -mt-[50%] lg:-mt-[12%]"></div>
      </div>

      <!-- COUCHE DE CONTENU (Au premier plan) -->
      <div class="relative z-10 w-full flex-grow flex flex-col items-center px-6 lg:px-12 max-w-[1400px] mx-auto pt-[12%] lg:pt-10 pb-24">
        
        <!-- Bouton + -->
        <a href="/app/vestiaire/add" class="bg-jaune text-bleu-marine h-16 w-16 rounded-full flex items-center justify-center shadow-lg hover:scale-105 transition-transform active:scale-95 shrink-0 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
          </svg>
        </a>

        <!-- Titre -->
        <h1 class="text-3xl lg:text-5xl font-black text-white font-display tracking-wide uppercase text-center">Vestiaire</h1>
        <p class="text-bleu-claire text-sm lg:text-base font-medium mt-1 text-center mb-6 lg:mb-8">Gérez vos pièces et trouvez l'inspiration.</p>

        <!-- Barre de Recherche -->
        <div class="mb-6 relative group w-full max-w-md mx-auto">
          <div class="absolute inset-y-0 left-0 pl-5 flex items-center pointer-events-none">
            <svg class="h-6 w-6 text-gray-400 group-focus-within:text-bleu-marine transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <input type="text" id="search-input" placeholder="Rechercher (ex: nike, veste...)" class="w-full bg-white rounded-full py-3.5 pl-14 pr-6 text-bleu-marine font-bold focus:outline-none focus:ring-4 focus:ring-bleu-claire/50 shadow-inner transition-all text-base placeholder-gray-400">
        </div>

        <div class="w-full flex flex-col">
          
          <!-- Filtres Catégories (flex-wrap pour passer à la ligne sur mobile, justify-center pour centrer) -->
          <div class="flex gap-2 lg:gap-3 flex-wrap justify-center mb-8 w-full">
            <button data-category="Tous" class="filter-btn bg-jaune text-bleu-marine px-6 lg:px-7 py-2.5 lg:py-3 rounded-full font-extrabold text-sm whitespace-nowrap shadow-md transition-all hover:scale-105 active:scale-95">Tous</button>
            <button data-category="haut" class="filter-btn bg-white/10 text-white border border-white/20 px-6 lg:px-7 py-2.5 lg:py-3 rounded-full font-bold text-sm whitespace-nowrap transition-all hover:scale-105 active:scale-95">Hauts</button>
            <button data-category="bas" class="filter-btn bg-white/10 text-white border border-white/20 px-6 lg:px-7 py-2.5 lg:py-3 rounded-full font-bold text-sm whitespace-nowrap transition-all hover:scale-105 active:scale-95">Bas</button>
            <button data-category="veste" class="filter-btn bg-white/10 text-white border border-white/20 px-6 lg:px-7 py-2.5 lg:py-3 rounded-full font-bold text-sm whitespace-nowrap transition-all hover:scale-105 active:scale-95">Vestes</button>
            <button data-category="chaussure" class="filter-btn bg-white/10 text-white border border-white/20 px-6 lg:px-7 py-2.5 lg:py-3 rounded-full font-bold text-sm whitespace-nowrap transition-all hover:scale-105 active:scale-95">Chaussures</button>
          </div>

          <!-- Chargement -->
          <div id="loading-state" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4 lg:gap-6 mt-2">
            {[1, 2, 3, 4, 5, 6].map(() => (
              <div class="bg-white/10 backdrop-blur-sm rounded-[2rem] aspect-[3/4] animate-pulse"></div>
            ))}
          </div>

          <!-- Grille des Vêtements -->
          <div id="clothes-grid" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4 lg:gap-6 mt-2 hidden">
          </div>

          <!-- État vide (Aucun résultat) -->
          <div id="empty-state" class="hidden flex-col items-center justify-center text-center py-20 px-6 bg-white/5 rounded-[3rem] border border-white/10 mt-6">
            <div class="w-20 h-20 bg-white/10 rounded-full flex items-center justify-center mb-6">
              <span class="text-4xl">🔍</span>
            </div>
            <h3 class="text-xl font-black text-white mb-2">Aucune pièce trouvée</h3>
            <p class="text-bleu-claire mb-8 max-w-sm">Essayez de modifier votre recherche ou ajoutez de nouveaux vêtements.</p>
          </div>

        </div>

      </div>
    </div>
  </div>
</AppLayout>

<style>
  .no-scrollbar::-webkit-scrollbar { display: none; }
  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
</style>

<script>
  import { pb } from '../../../../backend/pb.mjs';
  import { getClothes, getClothImageUrl } from '../../../../backend/clothes.js';

  if (!pb.authStore.isValid) {
    window.location.href = '/app/login';
  }

  const grid = document.getElementById('clothes-grid');
  const loading = document.getElementById('loading-state');
  const emptyState = document.getElementById('empty-state');
  const filterBtns = document.querySelectorAll('.filter-btn');
  const searchInput = document.getElementById('search-input');

  let allLoadedClothes = [];

  async function fetchClothes(category = 'Tous') {
    if (!grid || !loading || !emptyState) return;

    grid.classList.add('hidden');
    emptyState.classList.add('hidden');
    loading.classList.remove('hidden');

    try {
      const userId = pb.authStore.model?.id;
      allLoadedClothes = await getClothes(userId, category);
      
      loading.classList.add('hidden');
      renderGrid();

    } catch (error) {
      console.error("Erreur :", error);
      loading.classList.add('hidden');
    }
  }

  function renderGrid() {
    if (!grid || !emptyState || !searchInput) return;

    // @ts-ignore
    const searchTerm = searchInput.value.toLowerCase().trim();
    
    const filteredClothes = allLoadedClothes.filter(record => {
      const clothName = (record.name || '').toLowerCase();
      return clothName.includes(searchTerm);
    });

    if (filteredClothes.length === 0) {
      grid.classList.add('hidden');
      emptyState.classList.remove('hidden');
      emptyState.classList.add('flex');
    } else {
      emptyState.classList.add('hidden');
      emptyState.classList.remove('flex');
      grid.innerHTML = '';
      
      filteredClothes.forEach(record => {
        const imageUrl = getClothImageUrl(record);
        const imgHtml = imageUrl 
          ? `<img src="${imageUrl}" alt="${record.name}" class="w-full h-full object-contain p-2 drop-shadow-md group-hover:scale-110 transition-transform duration-500" />`
          : `<div class="w-full h-full bg-gray-100 flex items-center justify-center text-gray-400 font-bold text-xs uppercase tracking-widest">Sans image</div>`;
        
        const favBadge = record.is_favorite 
          ? `<div class="absolute top-3 right-3 bg-white p-1.5 rounded-full shadow-md z-10 text-xs">❤️</div>` 
          : '';

        const weatherEmojis = { 'chaud': '☀️', 'froid': '❄️', 'pluie': '🌧️', 'neutre': '☁️' };
        // @ts-ignore
        const wEmoji = weatherEmojis[record.weather_tag] || '☁️';

        const cardHtml = `
          <a href="/app/vestiaire/${record.id}" class="bg-white rounded-[2rem] p-3 flex flex-col gap-3 relative group cursor-pointer hover:-translate-y-1 transition-all duration-300">
            <div class="w-full aspect-square rounded-[1.5rem] overflow-hidden bg-gray-50 relative flex items-center justify-center">
              ${favBadge}
              <div class="absolute top-3 left-3 bg-white/90 backdrop-blur-sm px-2 py-1 rounded-lg shadow-sm z-10 text-[10px] font-black uppercase text-gray-500 tracking-wider">
                ${wEmoji} ${record.category}
              </div>
              ${imgHtml}
            </div>
            <div class="px-2 pb-1 text-center">
              <p class="font-black text-bleu-marine text-[15px] truncate leading-tight">${record.name || 'Sans nom'}</p>
            </div>
          </a>
        `;
        grid.innerHTML += cardHtml;
      });

      grid.classList.remove('hidden');
    }
  }

  searchInput?.addEventListener('input', () => {
    renderGrid(); 
  });

  filterBtns.forEach(btn => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget; 
      // @ts-ignore
      const category = target.dataset.category;

      // Reset tous les boutons (style inactif sombre)
      filterBtns.forEach(b => {
        b.classList.remove('bg-jaune', 'text-bleu-marine');
        b.classList.add('bg-white/10', 'text-white', 'border', 'border-white/20');
      });
      
      // Activer le bouton cliqué (style actif jaune)
      // @ts-ignore
      target.classList.remove('bg-white/10', 'text-white', 'border', 'border-white/20');
      // @ts-ignore
      target.classList.add('bg-jaune', 'text-bleu-marine');

      // @ts-ignore
      searchInput.value = '';

      if(category) fetchClothes(category);
    });
  });

  fetchClothes('Tous');
</script>