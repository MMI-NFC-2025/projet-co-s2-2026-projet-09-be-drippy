---
/* src/pages/app/cgu.astro */
import LandingLayout from '../layouts/LandingLayout.astro';
---

<LandingLayout title="CGU">

  <div class="flex flex-col w-full relative z-10 mb-12 lg:mb-16">
    
    <section class="grille relative z-10 mt-16 lg:mt-32">
      <div class="col-full bg-bleu-claire rounded-[32px] p-6 lg:p-16 text-center">
        <h1 class="font-display text-2xl lg:text-titre-md text-bleu-marine leading-tight">
          Conditions Générales d'Utilisation
        </h1>
        <p class="text-sm lg:text-corp-lg text-bleu-marine/80 mt-4 max-w-2xl mx-auto">
          Dernière mise à jour : Juin 2026. Découvrez les règles régissant l'utilisation de Be Drippy.
        </p>
      </div>
    </section>
    <section class="grille relative z-10 mt-8 lg:mt-16">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 w-full">
        
        {[
          { title: "1. But de l'application", text: "Be Drippy est une application conçue pour simplifier la gestion de votre vestiaire au quotidien : organisation, suggestions IA basées sur la météo et espace communautaire." },
          { title: "2. Nature du service", text: "Assistant de mode et d'organisation. Nos suggestions sont générées par IA à titre indicatif ; elles ne constituent pas une obligation de résultat esthétique ou de confort." },
          { title: "3. Services Freemium", text: "Fonctionnalités de base (vestiaire, aide vestimentaire) gratuites. Fonctions exclusives (Espace Communauté) via abonnement Premium." },
          { title: "4. Communauté & Modération", text: "Espace bienveillant. Pseudonyme recommandé, interdiction des insultes, harcèlement, contenus illégaux ou publicités non autorisées. Sanction : bannissement." },
          { title: "5. Données personnelles", text: "Collecte limitée à votre vestiaire et préférences après accord. Données sécurisées, non revendues. Droit d'accès, modification et suppression via les paramètres." },
          { title: "6. Âge requis", text: "Utilisation réservée aux personnes âgées d'au moins 15 ans." },
          { title: "7. Liens externes", text: "Nous déclinons toute responsabilité concernant le contenu des sites tiers ou partenaires vers lesquels Be Drippy peut renvoyer." },
          { title: "8. Propriété intellectuelle", text: "Logo, design, algorithmes et textes sont la propriété exclusive de Be Drippy. Reproduction interdite sans accord écrit." },
          { title: "9. Modification des CGU", text: "Nous pouvons mettre à jour ces règles. Vous serez averti via l'application ; toute utilisation après mise à jour vaut acceptation des nouvelles règles." },
          { title: "10. Litiges", text: "Soumis au droit français. En cas de désaccord, solution amiable privilégiée, à défaut tribunaux français compétents." }
        ].map((item) => (
          <div class="bg-bleu-claire rounded-[32px] p-8 flex flex-col gap-4">
            <h3 class="font-display text-lg lg:text-titre-sm text-bleu-marine leading-tight">{item.title}</h3>
            <p class="text-sm lg:text-corp-md text-bleu-marine/80 leading-relaxed">{item.text}</p>
          </div>
        ))}

      </div>
    </section>

    <section class="grille relative z-10 mt-8 lg:mt-16">
      <div class="col-full bg-bleu-marine rounded-[32px] p-8 lg:p-16 flex flex-col items-center lg:flex-row justify-between gap-6 shadow-2xl relative overflow-hidden text-center lg:text-left">
        <div class="relative z-10">
          <h2 class="font-display text-xl lg:text-titre-md text-white leading-tight mb-2">
            Des questions sur nos CGU ?
          </h2>
          <p class="text-sm lg:text-corp-lg text-white/80 max-w-lg">
            N'hésitez pas à nous contacter à contact@bedrippy.fr
          </p>
        </div>
        <a href="/" class="bg-jaune text-bleu-marine font-display text-sm lg:text-corp-md uppercase tracking-wider px-8 py-4 rounded-full w-full lg:w-auto text-center z-10 hover:scale-105 transition-transform">
          Retour à l'accueil
        </a>
      </div>
    </section>

  </div>
</LandingLayout>